executable     = run_dch_merge_chunks_persample.sh
environment    = "REPO_DIR=$ENV(PWD)/../.."
arguments      = output/trees/chunks/run2_noFR_metphi_zpt_recoil_roccor_toppt_chargeflip_LT output/trees/run2_noFR_metphi_zpt_recoil_roccor_toppt_chargeflip_LT $(year) $(sample) masstree
output         = logs/dch_tight_treeonly_merge_persample_$(year)_$(sample).out
error          = logs/dch_tight_treeonly_merge_persample_$(year)_$(sample).err
log            = logs/dch_tight_treeonly_merge_persample_$(year)_$(sample).log
request_cpus   = 1
request_memory = 2000
request_disk   = 2000000
+JobFlavour    = "workday"
use_x509userproxy = true
x509userproxy  = $ENV(HOME)/.grid_proxy/x509up.pem

queue year,sample from mergelist_treeonly_persample.txt
